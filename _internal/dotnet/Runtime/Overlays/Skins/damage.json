{
  "schema_version": 2,
  "name": "伤害统计",
  "settings": [
    {
      "key": "show_character_avatars",
      "label": "显示角色头像",
      "type": "select",
      "default": "on",
      "options": [
        {
          "value": "on",
          "label": "开"
        },
        {
          "value": "off",
          "label": "关"
        }
      ]
    },
    {
      "key": "avatar_size_percent",
      "label": "头像大小",
      "type": "slider",
      "min": 50,
      "max": 300,
      "default": 100
    },
    {
      "key": "bar_mode",
      "label": "伤害条与排序",
      "type": "select",
      "default": "rdps",
      "options": [
        {
          "value": "dps",
          "label": "DMG / DPS"
        },
        {
          "value": "rdps",
          "label": "rDMG / rDPS"
        }
      ],
      "legacy_field": "bar_mode"
    },
    {
      "key": "columns",
      "label": "显示列",
      "type": "multiselect",
      "default": [
        "damage",
        "damage_rate",
        "rdamage",
        "rdamage_rate"
      ],
      "options": [
        {
          "value": "damage",
          "label": "DMG"
        },
        {
          "value": "damage_rate",
          "label": "DMG rate"
        },
        {
          "value": "rdamage",
          "label": "rDMG"
        },
        {
          "value": "rdamage_rate",
          "label": "rDMG rate"
        }
      ],
      "legacy_field": "visible_columns"
    },
    {
      "key": "theme",
      "label": "背景模式",
      "type": "select",
      "default": "light",
      "options": [
        {
          "value": "endfield",
          "label": "终末地"
        },
        {
          "value": "light",
          "label": "浅色"
        },
        {
          "value": "dark",
          "label": "深色"
        },
        {
          "value": "transparent",
          "label": "透明背景"
        }
      ],
      "legacy_field": "overlay_theme"
    }
  ],
  "window": {
    "min_width": 320,
    "min_height": 160,
    "default_width": 800,
    "default_height": 380
  },
  "modules": [
    {
      "type": "damage"
    }
  ],
  "layout": {
    "direction": "single"
  }
}
