{
  "schema_version": 1, "name": "BUFF 观测", "entry": "index.html",
  "subscriptions": ["buff_snapshot"], "font_mode": "css",
  "window": {"min_width": 180, "min_height": 80, "default_width": 360, "default_height": 340},
  "settings": [
    {"key":"targets","label":"显示对象","type":"select","default":"characters","options":[{"value":"characters","label":"角色 BUFF"},{"value":"all","label":"全部观测对象"}]},
    {"key":"durations","label":"时长筛选","type":"select","default":"all","options":[{"value":"all","label":"全部（包含时长未知）"},{"value":"timed","label":"仅有明确时长"}]},
    {"key":"layout","label":"排列方式","type":"select","default":"list","options":[{"value":"list","label":"列表"},{"value":"grid","label":"自动多列"}]},
    {"key":"theme","label":"背景模式","type":"select","default":"light","legacy_field":"overlay_theme","options":[{"value":"light","label":"浅色"},{"value":"dark","label":"深色"},{"value":"transparent","label":"透明背景"}]}
  ]
}
