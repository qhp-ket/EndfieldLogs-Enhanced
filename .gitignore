# Source-only allowlist: unknown root entries, private state and local tools stay local.
/AGENTS.md
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/Start-GUI.cmd
!/Setup-Dev.cmd
!/launch_gui.py
!/_internal/
!/_development/
/_internal/*
!/_internal/src/
!/_internal/packages/
!/_internal/data/
!/_internal/jsondata/
!/_internal/secrets/

# Install the extracted runtime bundle; raw upstream data remains local.
/_internal/data/*
!/_internal/data/README.md
!/_internal/data/resource-manifest.json
!/_internal/data/game_resource_snapshot.json
!/_internal/data/local_semantics/
!/_internal/data/packet_semantics/
/_internal/data/local_semantics/*
!/_internal/data/local_semantics/team_energy_rules.json
!/_internal/data/local_semantics/skill_frame_rules.json
/_internal/data/packet_semantics/*
!/_internal/data/packet_semantics/rdps_semantics_registry.json
/_internal/jsondata/*
!/_internal/jsondata/README.md
/_internal/secrets/*
!/_internal/secrets/README.md

# Current tests, tools and docs; archives and implementation diaries stay local.
/_development/*
!/_development/README.md
!/_development/run_tests.py
!/_development/tests/
!/_development/environment/
!/_development/examples/
!/_development/portable/
!/_development/docs/
!/_development/tools/
/_development/docs/*
!/_development/docs/battle-analysis-components.md
