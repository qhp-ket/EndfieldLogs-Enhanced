{
  "schema_version": 2,
  "name": "伤害与连携",
  "window": {
    "min_width": 320,
    "min_height": 160,
    "default_width": 800,
    "default_height": 500
  },
  "modules": [
    {
      "type": "damage",
      "settings": {
        "bar_mode": "rdps"
      },
      "setting_bindings": {
        "avatar_size_percent": "size"
      }
    },
    {
      "type": "combo_skill",
      "settings": {
        "display_style": "bars"
      }
    }
  ],
  "layout": {
    "direction": "vertical"
  },
  "theme": {
    "background": "#20252d",
    "spacing": 8,
    "padding": 4
  },
  "settings": [
    {
      "key": "size",
      "label": "伤害头像大小",
      "type": "slider",
      "min": 50,
      "max": 300,
      "default": 100
    }
  ]
}
